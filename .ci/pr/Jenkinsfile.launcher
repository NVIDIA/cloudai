#!/usr/bin/groovy

// Entry point of the PR pipeline. Blossom triggers this job; it runs the small
// leaf jobs below in parallel, each of which runs .ci/Jenkinsfile with its own
// matrix from .ci/pr/ and reports its own commit status.

// Blossom's helper, used to report commit status back to the pull request.
@Library('blossom-github-lib@master')

import ipp.blossom.*

// Leaf jobs, keyed by parallel-branch name. Declared in .ci/proj_jjb.yaml.
def leafJobs = [
    'copyright': 'cloudai-pr-copyright',
    'secrets':   'cloudai-pr-secrets',
    'coverity':  'cloudai-pr-coverity',
    'coverage':  'cloudai-pr-coverage',
]

def githubHelper = null
def pipelineOverviewUrl = ""
// A manual run hands its own sha1 to every leaf.
def sha1 = params.sha1

// Injected by the Blossom workflow for PR-triggered runs; absent when a
// maintainer starts the job by hand, so every use is guarded.
if (params.githubData) {
    withCredentials([usernamePassword(credentialsId: 'svcnbu-swx-cloudai-github-token',
                                      passwordVariable: 'GIT_PASSWORD',
                                      usernameVariable: 'GIT_USERNAME')]) {
        githubHelper = GithubHelper.getInstance("${GIT_PASSWORD}", params.githubData)
    }
    pipelineOverviewUrl = "${env.BUILD_URL}/pipeline-overview/"
    githubHelper.updateCommitStatus(pipelineOverviewUrl, "CI started",
                                    GitHubCommitState.PENDING, env.JOB_BASE_NAME)
    currentBuild.description = githubHelper.getBuildDescription()
}

try {
    if (params.githubData) {
        // Resolve refs/pull/<n>/merge once, so every leaf tests the same
        // commit even if the base branch moves while they start. Inside the
        // try, so a failed lookup still closes the pending status.
        sha1 = githubHelper.getMergedSHA()
        if (!sha1) {
            error "Could not resolve the merge commit of the pull request"
        }
    }

    // A failing leaf does not stop its siblings; parallel rethrows once all
    // of them finish, so this job fails if any leaf failed.
    parallel(leafJobs.collectEntries { branch, job ->
        [(branch): {
            build job: job, parameters: [
                string(name: 'sha1', value: sha1),
                string(name: 'githubData', value: params.githubData),
            ]
        }]
    })
} catch (Exception ex) {
    currentBuild.result = 'FAILURE'
    println ex
    throw ex
} finally {
    if (params.githubData) {
        githubHelper.updateCommitStatus(
            pipelineOverviewUrl,
            "CI completed",
            currentBuild.resultIsBetterOrEqualTo('SUCCESS') ? GitHubCommitState.SUCCESS
                                                            : GitHubCommitState.FAILURE,
            env.JOB_BASE_NAME
        )
    }
}
