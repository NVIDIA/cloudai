{% extends "base-report.jinja2" %}

{% block extra_head %}
<meta charset="UTF-8">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.js"
        integrity="sha384-tgbB5AKnszdcfwcZtTfuhR3Ko1XZdlDfsLtkxiiAZiVkkXCkFmp+FQFh+V/UTo54"
        crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/hammerjs@2.0.8/hammer.min.js"
        integrity="sha384-Cs3dgUx6+jDxxuqHvVH8Onpyj2LF1gKZurLDlhqzuJmUqVYMJ0THTWpxK5Z086Zm"
        crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.2.0/dist/chartjs-plugin-zoom.min.js"
        integrity="sha384-dwwI6ICEN/0ZQlS5owhUa/6ZzvwUPmjH45bFVCAcjgjTulbHJvlE+TGU3g1k0N3R"
        crossorigin="anonymous"></script>
<style>
    * {
        box-sizing: border-box;
    }
    body {
        max-width: none;
        overflow-x: hidden;
    }
    .comparison-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 42rem), 1fr));
        align-items: start;
        gap: 1.25rem;
    }
    .comparison-card {
        width: 100%;
        min-width: 0;
        padding: 1.25rem;
        border: 1px solid var(--nv-border);
        border-radius: var(--radius-lg);
        background: rgba(255, 255, 255, 0.98);
        box-shadow: var(--nv-shadow);
    }
    .comparison-card h2 {
        margin: 0;
        font-size: 1.35rem;
    }
    .comparison-group {
        margin: 0.15rem 0 1rem;
        color: var(--nv-muted);
        font-size: 0.92rem;
    }
    .chart-shell {
        position: relative;
        height: clamp(440px, 48vh, 520px);
        min-height: 440px;
    }
    .chart-shell canvas {
        width: 100% !important;
        height: 100% !important;
    }
    .chart-controls {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem 1rem;
        margin-top: 0.55rem;
    }
    .chart-controls p {
        margin: 0;
        font-size: 0.8rem;
    }
    .reset-zoom {
        padding: 0.35rem 0.7rem;
        border: 1px solid rgba(118, 185, 0, 0.42);
        border-radius: 999px;
        background: var(--nv-surface);
        color: var(--nv-green-strong);
        font-weight: 700;
        cursor: pointer;
    }
    .reset-zoom:hover {
        background: var(--nv-green-soft);
    }
    .case-context {
        margin-top: 0.85rem;
        padding: 0.75rem 0.85rem;
        border: 1px solid rgba(17, 17, 17, 0.07);
        border-radius: var(--radius-md);
        background: var(--nv-surface-alt);
    }
    .case-context summary {
        color: var(--nv-ink);
        font-weight: 700;
        cursor: pointer;
    }
    .case-context-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 30rem), 1fr));
        gap: 0.75rem;
        margin-top: 0.75rem;
    }
    .case-context-card {
        min-width: 0;
        padding: 0.7rem 0.8rem;
        border: 1px solid rgba(17, 17, 17, 0.08);
        border-radius: var(--radius-sm);
        background: var(--nv-surface);
    }
    .case-context-card h3 {
        margin: 0 0 0.45rem;
        font-size: 0.92rem;
    }
    .case-differences-yaml {
        margin: 0;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        word-break: normal;
        font-family: "SFMono-Regular", SFMono-Regular, Consolas, "Liberation Mono", Menlo, monospace;
        font-size: 0.76rem;
        color: var(--nv-ink);
        line-height: 1.45;
    }
    .no-differences {
        margin: 0;
        font-size: 0.8rem;
    }
    .chart-fallback {
        margin: 0.7rem 0 0;
        font-size: 0.88rem;
    }
    .chart-shell.is-enhanced ~ .chart-fallback {
        display: none;
    }
    .comparison-table-region {
        width: fit-content;
        max-width: 100%;
        margin-top: 1.1rem;
    }
    .table-toolbar {
        position: relative;
        display: flex;
        width: fit-content;
        margin-bottom: 0.45rem;
    }
    .column-picker {
        display: none;
    }
    .column-picker.is-enhanced {
        display: block;
    }
    .column-picker summary {
        padding: 0.35rem 0.7rem;
        border: 1px solid rgba(118, 185, 0, 0.42);
        border-radius: 999px;
        background: var(--nv-surface);
        color: var(--nv-green-strong);
        font-size: 0.8rem;
        font-weight: 700;
        cursor: pointer;
        list-style: none;
    }
    .column-picker summary::-webkit-details-marker {
        display: none;
    }
    .column-picker summary:hover {
        background: var(--nv-green-soft);
    }
    .column-picker-panel {
        position: absolute;
        z-index: 10;
        top: calc(100% + 0.35rem);
        left: 0;
        display: grid;
        gap: 0.35rem;
        width: max-content;
        min-width: 16rem;
        max-width: min(32rem, calc(100vw - 3rem));
        max-height: min(28rem, 70vh);
        padding: 0.7rem;
        overflow: auto;
        border: 1px solid var(--nv-border);
        border-radius: var(--radius-md);
        background: var(--nv-surface);
        box-shadow: var(--nv-shadow);
    }
    .column-picker-option {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        align-items: start;
        gap: 0.5rem;
        min-width: 0;
        font-size: 0.8rem;
        line-height: 1.35;
        cursor: pointer;
    }
    .column-picker-option span {
        overflow-wrap: anywhere;
    }
    .show-all-columns {
        width: fit-content;
        margin-top: 0.35rem;
        padding: 0.3rem 0.55rem;
        border: 1px solid var(--nv-border);
        border-radius: var(--radius-sm);
        background: var(--nv-surface-alt);
        color: var(--nv-ink);
        font-size: 0.78rem;
        font-weight: 700;
        cursor: pointer;
    }
    .comparison-table-shell {
        width: fit-content;
        max-width: 100%;
        overflow-x: auto;
        overscroll-behavior-inline: contain;
        scrollbar-gutter: stable;
        border: 1px solid rgba(17, 17, 17, 0.07);
        border-radius: var(--radius-md);
    }
    .comparison-table {
        margin: 0;
        width: max-content;
        max-width: none;
        table-layout: auto;
        border-radius: 0;
        box-shadow: none;
        font-size: 0.9rem;
    }
    .comparison-table td {
        white-space: nowrap;
    }
    .comparison-table th {
        min-width: 8rem;
        vertical-align: bottom;
        white-space: normal;
    }
    .pareto-table {
        width: 100%;
        min-width: 60rem;
        table-layout: fixed;
    }
    .pareto-table th {
        min-width: 0;
    }
    .pareto-table td {
        white-space: normal;
        vertical-align: top;
        overflow-wrap: anywhere;
    }
    .pareto-table pre, .pareto-inspector pre {
        max-height: 20rem;
        overflow: auto;
    }
    .pareto-inspector {
        margin-top: 0.75rem;
        padding: 1rem;
        border: 1px solid var(--nv-border);
        border-radius: var(--radius-md);
        background: var(--nv-surface-alt);
        user-select: text;
        overflow-wrap: anywhere;
        container-type: inline-size;
    }
    .pareto-inspector h3, .pareto-inspector p {
        margin: 0 0 0.5rem;
    }
    .pareto-inspector .js-point-clear {
        margin-top: 0.75rem;
    }
    .js-point-properties {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.6rem 1.25rem;
        margin: 0.6rem 0;
    }
    .pareto-property-group {
        min-width: 0;
        padding-top: 0.5rem;
        border-top: 1px solid var(--nv-border);
    }
    .pareto-property-group[data-group="Measurements"],
    .pareto-property-group[data-group="Workload"],
    .pareto-property-group[data-group="Serving"] {
        grid-column: 1 / -1;
    }
    .pareto-property-group h4 {
        margin: 0;
        font-size: 0.9rem;
    }
    .pareto-properties {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
        gap: 0.35rem 0.85rem;
        margin: 0.4rem 0 0.15rem;
    }
    .pareto-property-group[data-group="Measurements"] .pareto-properties {
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    }
    .pareto-property-group[data-group="Workload"] .pareto-properties {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pareto-properties dt {
        color: var(--nv-muted);
        font-size: 0.8rem;
    }
    .pareto-properties dd {
        margin: 0.1rem 0 0;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }
    @container (max-width: 37.25rem) {
        .js-point-properties,
        .pareto-property-group[data-group="Workload"] .pareto-properties {
            grid-template-columns: minmax(0, 1fr);
        }
    }
    .pareto-point-button {
        padding: 0;
        border: 0;
        background: none;
        color: var(--nv-green-strong);
        font: inherit;
        text-align: left;
        text-decoration: underline;
        cursor: pointer;
    }
    .run-label {
        display: block;
        max-width: 18rem;
        overflow-wrap: anywhere;
        color: var(--nv-ink);
    }
    .run-differences {
        margin: 0.45rem 0 0;
        max-width: 18rem;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        word-break: normal;
        color: var(--nv-muted);
        font-size: 0.68rem;
        font-weight: 500;
        line-height: 1.35;
    }
    .metric-label {
        display: block;
        margin-top: 0.2rem;
        color: var(--nv-muted);
        font-size: 0.76rem;
        font-weight: 600;
    }
    .empty-report {
        padding: 1rem;
        border: 1px solid var(--nv-border);
        border-radius: var(--radius-md);
        background: var(--nv-surface);
    }
    @media (max-width: 640px) {
        .comparison-card {
            padding: 1rem;
        }
        .chart-shell {
            height: clamp(360px, 55vh, 460px);
            min-height: 360px;
        }
        .comparison-table th,
        .comparison-table td {
            padding: 10px 12px;
        }
        .run-differences {
            max-width: 15rem;
        }
    }
</style>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".js-column-picker").forEach((picker) => {
            const table = document.getElementById(picker.dataset.tableId);
            if (!table) {
                return;
            }

            const inputs = Array.from(picker.querySelectorAll(".js-column-toggle"));
            const summary = picker.querySelector(".js-column-picker-summary");
            const showAllButton = picker.querySelector(".js-show-all-columns");

            function setColumnVisibility(columnIndex, visible) {
                Array.from(table.rows).forEach((row) => {
                    const cell = row.cells[columnIndex];
                    if (cell) {
                        cell.hidden = !visible;
                    }
                });
            }

            function updateSummary() {
                const visibleCount = inputs.filter((input) => input.checked).length;
                summary.textContent = `Columns (${visibleCount}/${inputs.length})`;
            }

            inputs.forEach((input) => {
                input.addEventListener("change", function () {
                    setColumnVisibility(Number(input.dataset.columnIndex), input.checked);
                    updateSummary();
                });
            });
            showAllButton.addEventListener("click", function () {
                inputs.forEach((input) => {
                    input.checked = true;
                    setColumnVisibility(Number(input.dataset.columnIndex), true);
                });
                updateSummary();
            });

            updateSummary();
            picker.classList.add("is-enhanced");
        });

        const rootStyles = getComputedStyle(document.documentElement);
        const nvidiaGreen = rootStyles.getPropertyValue("--nv-green").trim() || "#76b900";
        const nvidiaDarkGray = rootStyles.getPropertyValue("--nv-dark-gray").trim() || "#1e1e1e";
        const pointStyles = ["circle", "rectRot", "triangle", "rect", "star", "crossRot", "dash"];

        function seriesColor(index) {
            if (index === 0) {
                return nvidiaGreen;
            }
            if (index === 1) {
                return nvidiaDarkGray;
            }
            const hue = Math.round((96 + (index - 2) * 137.508) % 360);
            return `hsl(${hue} 68% 40%)`;
        }

        function initializeComparisonChart(canvas) {
            const dataNode = document.getElementById(canvas.dataset.chartDataId);
            if (!dataNode || typeof Chart === "undefined" || canvas.dataset.chartInitialized === "true") {
                return;
            }
            canvas.dataset.chartInitialized = "true";

            const payload = JSON.parse(dataNode.textContent);
            const isPareto = payload.pareto === true;
            const isLine = payload.type === "line";
            const isCategory = payload.x_axis_type === "category";
            const isIndexedCategory = payload.x_axis_type === "indexed_category";
            const card = canvas.closest(".comparison-card");
            const numberFormat = new Intl.NumberFormat("en-US", {maximumFractionDigits: 2});
            function formatValue(value) {
                if (typeof value === "number") {
                    return value !== 0 && Math.abs(value) < 0.01 ? value.toPrecision(3) : numberFormat.format(value);
                }
                return Array.isArray(value) ? value.join(", ") : String(value);
            }
            let pinnedPoint = false;
            const inspector = isPareto ? card.querySelector(".pareto-inspector") : null;
            function pointPropertyGroups(point) {
                const groups = {Measurements: {
                    [payload.x_axis_label]: point.x,
                    [payload.y_axis_label]: point.y,
                    ...(point.dimensions ? {"Metric dimensions": point.dimensions} : {})
                }};
                const remaining = {...point.context};
                const settings = {
                    Workload: ["Model", "Container image", "Workload", "Backend"],
                    "Request settings": ["Concurrency", "Users", "Input tokens", "Output tokens", "Requests", "Request rate"],
                    Resources: ["Nodes", "Allocated GPUs", "Serving GPUs", "Prefill and decode share nodes"]
                };
                Object.entries(settings).forEach(([group, labels]) => {
                    groups[group] = {};
                    labels.forEach((label) => {
                        if (Object.hasOwn(remaining, label)) {
                            groups[group][label] = remaining[label];
                            delete remaining[label];
                        }
                    });
                });
                ["Serving", "Prefill", "Decode"].forEach((role) => {
                    groups[role] = {};
                    const orderedLabels = ["Model", "Nodes", "Instances", "Nodes per instance", "Instances per node",
                        "GPU IDs", "TP", "PP", "DP", "Expert parallel", "Precision", "Quantization"];
                    const labels = [...new Set([...orderedLabels.map((label) => `${role} / ${label}`),
                        ...Object.keys(remaining)])];
                    labels.forEach((label) => {
                        if (label.startsWith(`${role} / `) && Object.hasOwn(remaining, label)) {
                            groups[role][label.slice(role.length + 3)] = remaining[label];
                            delete remaining[label];
                        }
                    });
                });
                groups["Other settings"] = remaining;
                return Object.entries(groups).filter(([, values]) => Object.keys(values).length);
            }
            function inspectPoint(point, pin = false) {
                if (!inspector || (pinnedPoint && !pin)) {
                    return;
                }
                pinnedPoint = pin;
                inspector.querySelector(".js-point-title").textContent = `${point.group} · ${point.status}`;
                inspector.querySelector(".js-point-run").textContent = point.run;
                inspector.querySelector(".js-point-hint").hidden = true;
                inspector.querySelector(".js-point-content").hidden = false;
                inspector.querySelector(".js-point-clear").textContent = pin ? "Unpin point" : "Clear selection";
                const fields = inspector.querySelector(".js-point-properties");
                fields.replaceChildren();
                pointPropertyGroups(point).forEach(([title, properties]) => {
                    const group = document.createElement("section");
                    group.className = "pareto-property-group";
                    group.dataset.group = title;
                    const heading = document.createElement("h4");
                    heading.textContent = title;
                    const list = document.createElement("dl");
                    list.className = "pareto-properties";
                    Object.entries(properties).forEach(([label, value]) => {
                        const item = document.createElement("div");
                        const name = document.createElement("dt");
                        const content = document.createElement("dd");
                        name.textContent = label;
                        content.textContent = formatValue(value);
                        item.append(name, content);
                        list.append(item);
                    });
                    group.append(heading, list);
                    fields.append(group);
                });
                inspector.querySelector(".js-point-artifact").textContent = point.artifact;
                const config = document.getElementById(`${point.id}-config`);
                inspector.querySelector(".js-point-config").textContent = config ? config.textContent : "";
            }

            if (isIndexedCategory) {
                payload.datasets.forEach((dataset) => {
                    dataset.data = dataset.data.map((value, index) => ({x: index, y: value}));
                });
            }
            payload.datasets.forEach((dataset, index) => {
                const color = dataset.is_sol ? payload.sol_color : seriesColor(dataset.source_color_index ?? index);
                dataset.borderColor = color;
                dataset.backgroundColor = color;
                dataset.order = dataset.is_sol ? 0 : 1;
                dataset.borderWidth = dataset.is_sol ? 3 : (isLine ? Math.max(2, 5 - index * 0.75) : 1);
                dataset.borderDash = dataset.is_sol ? [8, 5] : [];
                dataset.borderCapStyle = "round";
                dataset.borderJoinStyle = "round";
                dataset.pointStyle = dataset.is_sol ? "rectRot" : pointStyles[index % pointStyles.length];
                dataset.pointRadius = dataset.is_sol ? 8 : (isLine ? Math.max(3, 6 - index * 0.5) : 0);
                dataset.pointHoverRadius = dataset.is_sol ? 10 : (isLine ? Math.max(5, 8 - index * 0.5) : 0);
                dataset.pointBackgroundColor = color;
                dataset.pointBorderColor = "#ffffff";
                dataset.pointBorderWidth = dataset.is_sol ? 2 : (isLine ? 1.5 : 0);
                dataset.tension = isLine ? 0.12 : 0;
                if (isPareto) {
                    dataset.showLine = dataset.is_frontier;
                    dataset.tension = 0;
                    dataset.borderWidth = dataset.is_frontier ? 2 : 0;
                    dataset.pointStyle = pointStyles[dataset.source_color_index % pointStyles.length];
                    dataset.pointRadius = dataset.is_frontier ? 6 : 3;
                    dataset.pointHoverRadius = 8;
                    dataset.pointHitRadius = 6;
                    dataset.pointBackgroundColor = dataset.is_frontier ? color : "#ffffff";
                    dataset.pointBorderColor = color;
                    dataset.pointBorderWidth = dataset.is_frontier ? 2 : 1;
                    dataset.order = dataset.is_frontier ? 0 : 1;
                }
            });

            const xScale = {
                type: isIndexedCategory ? "linear" : payload.x_axis_type,
                title: {
                    display: true,
                    text: payload.x_axis_label
                },
                grid: {
                    color: "rgba(57, 66, 78, 0.08)"
                }
            };
            if (isPareto) {
                xScale.ticks = {callback: formatValue};
                xScale.beginAtZero = true;
            }
            if (isIndexedCategory) {
                xScale.min = -0.5;
                xScale.max = payload.labels.length - 0.5;
                xScale.afterBuildTicks = function (axis) {
                    const firstTick = Math.max(0, Math.ceil(axis.min));
                    const lastTick = Math.min(payload.labels.length - 1, Math.floor(axis.max));
                    axis.ticks = payload.labels
                        .map((_label, index) => ({value: index}))
                        .filter((tick) => tick.value >= firstTick && tick.value <= lastTick);
                };
                xScale.ticks = {
                    autoSkip: false,
                    minRotation: 45,
                    maxRotation: 45,
                    padding: 4,
                    font: {
                        size: 10
                    },
                    callback: function (value) {
                        const index = Math.round(value);
                        return Math.abs(value - index) < 0.001 ? (payload.labels[index] || "") : "";
                    }
                };
            }

            const numericValues = payload.datasets.flatMap((dataset) => dataset.data.map((point) => {
                const value = point !== null && typeof point === "object" ? point.y : point;
                return typeof value === "number" && Number.isFinite(value) ? value : null;
            })).filter((value) => value !== null);
            const positiveValues = numericValues.filter((value) => value > 0);
            const useAutoLogScale = payload.y_axis_type === "auto"
                && positiveValues.length === numericValues.length
                && Math.max(...positiveValues) / Math.min(...positiveValues) >= 100;
            const yAxisType = useAutoLogScale ? "logarithmic" :
                (payload.y_axis_type === "auto" ? "linear" : payload.y_axis_type);

            const chart = new Chart(canvas, {
                type: payload.type,
                data: {
                    labels: payload.labels,
                    datasets: payload.datasets
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    devicePixelRatio: Math.min(window.devicePixelRatio || 1, 1.5),
                    animation: false,
                    interaction: {
                        mode: isPareto ? "nearest" : "index",
                        intersect: true
                    },
                    onHover: function (_event, elements) {
                        if (isPareto && elements.length) {
                            const hit = elements[0];
                            inspectPoint(payload.datasets[hit.datasetIndex].data[hit.index]);
                        }
                    },
                    onClick: function (_event, elements) {
                        if (isPareto && elements.length) {
                            const hit = elements[0];
                            inspectPoint(payload.datasets[hit.datasetIndex].data[hit.index], true);
                        }
                    },
                    plugins: {
                        legend: {
                            position: "bottom",
                            labels: {
                                generateLabels: function (chart) {
                                    return Chart.defaults.plugins.legend.labels.generateLabels(chart).map((item) => ({
                                        ...item,
                                        text: `\u2002${item.text}` // Half-em space follows the label font size.
                                    }));
                                },
                                filter: (item, data) => !isPareto || data.datasets[item.datasetIndex].is_frontier,
                                usePointStyle: true,
                                boxWidth: 8,
                                padding: 10,
                                font: {
                                    size: 11
                                }
                            },
                            onClick: function (_event, item, legend) {
                                const current = legend.chart;
                                const visible = !current.isDatasetVisible(item.datasetIndex);
                                const group = payload.datasets[item.datasetIndex].source_color_index;
                                payload.datasets.forEach((dataset, index) => {
                                    if (index === item.datasetIndex || (isPareto && dataset.source_color_index === group)) {
                                        const showDominated = card.querySelector(".js-show-dominated")?.checked;
                                        current.setDatasetVisibility(index, visible && (!isPareto || dataset.is_frontier || showDominated));
                                    }
                                });
                                current.update();
                            }
                        },
                        tooltip: {
                            enabled: !isPareto,
                            callbacks: {
                                title: function (items) {
                                    if (!items.length) {
                                        return "";
                                    }
                                    const parsed = items[0].parsed;
                                    const categoryLabel = isIndexedCategory
                                        ? payload.labels[Math.round(parsed.x)]
                                        : items[0].label;
                                    return payload.x_axis_label + ": "
                                        + ((isCategory || isIndexedCategory) ? categoryLabel : parsed.x);
                                },
                                label: function (context) {
                                    const value = context.parsed.y;
                                    return context.dataset.label + " — " + payload.y_axis_label + ": " + value;
                                }
                            }
                        },
                        zoom: {
                            pan: {
                                enabled: true,
                                mode: "xy",
                                modifierKey: "shift",
                                threshold: 2
                            },
                            zoom: {
                                wheel: {
                                    enabled: false
                                },
                                pinch: {
                                    enabled: true
                                },
                                mode: "xy"
                            }
                        }
                    },
                    scales: {
                        x: xScale,
                        y: {
                            type: yAxisType,
                            ticks: isPareto ? {callback: formatValue} : {},
                            beginAtZero: (isPareto || payload.type === "bar") && yAxisType === "linear",
                            title: {
                                display: true,
                                text: payload.y_axis_label + (yAxisType === "logarithmic" ? " (log scale)" : "")
                            },
                            grid: {
                                color: "rgba(57, 66, 78, 0.10)"
                            }
                        }
                    }
                }
            });
            canvas.parentElement.classList.add("is-enhanced");

            canvas.addEventListener("wheel", function (event) {
                const isShiftWheel = event.shiftKey;
                const isTrackpadPinch = event.ctrlKey && !event.shiftKey;
                if (!isShiftWheel && !isTrackpadPinch) {
                    return;
                }

                const delta = Math.abs(event.deltaY) >= Math.abs(event.deltaX) ? event.deltaY : event.deltaX;
                if (delta === 0) {
                    return;
                }

                event.preventDefault();
                const speed = isTrackpadPinch ? 0.02 : 0.1;
                const factor = delta < 0 ? 1 + speed : 2 - 1 / (1 - speed);
                const rect = canvas.getBoundingClientRect();
                chart.zoom(
                    {
                        x: factor,
                        y: factor,
                        focalPoint: {
                            x: event.clientX - rect.left,
                            y: event.clientY - rect.top
                        }
                    },
                    "none"
                );
            }, {passive: false});

            if (isPareto) {
                card.querySelector(".js-show-dominated").addEventListener("change", function (event) {
                    payload.datasets.forEach((dataset, index) => {
                        if (!dataset.is_frontier) {
                            const frontierIndex = payload.datasets.findIndex((candidate) =>
                                candidate.is_frontier && candidate.source_color_index === dataset.source_color_index);
                            chart.setDatasetVisibility(index, event.target.checked && chart.isDatasetVisible(frontierIndex));
                        }
                    });
                    if (typeof chart.resetZoom === "function") {
                        chart.resetZoom();
                    }
                    chart.update();
                });
                inspector.querySelector(".js-point-clear").addEventListener("click", function () {
                    pinnedPoint = false;
                    inspector.querySelector(".js-point-hint").hidden = false;
                    inspector.querySelector(".js-point-content").hidden = true;
                    inspector.querySelector(".js-point-title").textContent = "Point details";
                    inspector.querySelector(".js-point-run").textContent = "";
                });
                card.querySelectorAll(".js-inspect-point").forEach((button) => {
                    button.addEventListener("click", function () {
                        const point = payload.datasets.flatMap((dataset) => dataset.data)
                            .find((candidate) => candidate.id === button.dataset.pointId);
                        inspectPoint(point, true);
                        inspector.scrollIntoView({block: "nearest"});
                    });
                });
            }
            const fallback = card ? card.querySelector(".chart-fallback") : null;
            if (fallback) {
                fallback.hidden = true;
            }
            const resetButton = card ? card.querySelector(".js-reset-zoom") : null;
            if (resetButton && typeof chart.resetZoom === "function") {
                resetButton.addEventListener("click", function () {
                    chart.resetZoom();
                });
                canvas.addEventListener("dblclick", function () {
                    chart.resetZoom();
                });
            } else if (resetButton) {
                resetButton.hidden = true;
            }
        }

        const chartCanvases = document.querySelectorAll(".js-comparison-chart");
        if ("IntersectionObserver" in window) {
            const chartObserver = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) {
                        return;
                    }
                    initializeComparisonChart(entry.target);
                    chartObserver.unobserve(entry.target);
                });
            }, {rootMargin: "300px 0px"});
            chartCanvases.forEach((canvas) => chartObserver.observe(canvas));
        } else {
            chartCanvases.forEach(initializeComparisonChart);
        }
    });
</script>
{% endblock %}

{% block content %}
{% if sections %}
<div class="comparison-grid">
    {% for section in sections %}
    <section class="comparison-card">
        <h2>{{ section.title }}</h2>
        {% if section.group_name %}<p class="comparison-group">{{ section.group_name }}</p>{% endif %}

        <div class="chart-shell">
            <canvas
                class="js-comparison-chart"
                data-chart-data-id="{{ section.chart.id }}-data"
                aria-label="{{ section.title }} {% if section.pareto %}Pareto{% else %}comparison{% endif %} chart"
            ></canvas>
        </div>
        <div class="chart-controls">
            {% if section.pareto %}
            <label><input type="checkbox" class="js-show-dominated"> Show dominated points</label>
            {% else %}
            <p>
                Click a legend entry to show or hide a series · Shift + wheel or pinch to zoom · Shift + drag to pan ·
                double-click to reset
            </p>
            {% endif %}
            <button type="button" class="reset-zoom js-reset-zoom">Reset view</button>
        </div>
        <p class="chart-fallback">Interactive chart unavailable. The complete numeric data remains available below.</p>
        <noscript><p class="chart-fallback">JavaScript is disabled. The complete numeric data remains available below.</p></noscript>
        <script type="application/json" id="{{ section.chart.id }}-data">{{ section.chart | tojson }}</script>

        {% if section.pareto %}
        {% include "pareto-table.jinja2" %}
        {% else %}
        <details class="case-context">
            <summary>Compared case parameters</summary>
            <div class="case-context-grid">
                {% for case in section.case_details %}
                <article class="case-context-card">
                    <h3>{{ case.name }}</h3>
                    {% if case.differences_yaml %}
                    <pre class="case-differences-yaml">{{ case.differences_yaml }}</pre>
                    {% else %}
                    <p class="no-differences">No differing parameters.</p>
                    {% endif %}
                </article>
                {% endfor %}
            </div>
        </details>

        {% set table_id = "comparison-table-" ~ loop.index0 %}
        <div class="comparison-table-region">
            <div class="table-toolbar">
                <details class="column-picker js-column-picker" data-table-id="{{ table_id }}">
                    <summary class="js-column-picker-summary">Columns</summary>
                    <div class="column-picker-panel" role="group" aria-label="Visible table columns">
                        {% for header in section.table.info_headers %}
                        <label class="column-picker-option">
                            <input
                                type="checkbox"
                                class="js-column-toggle"
                                data-column-index="{{ loop.index0 }}"
                                checked
                            >
                            <span>{{ header }}</span>
                        </label>
                        {% endfor %}
                        {% set info_column_count = section.table.info_headers | length %}
                        {% for header in section.table.data_headers %}
                        <label class="column-picker-option">
                            <input
                                type="checkbox"
                                class="js-column-toggle"
                                data-column-index="{{ info_column_count + loop.index0 }}"
                                checked
                            >
                            <span>{{ header.name }} · {{ header.metric }}</span>
                        </label>
                        {% endfor %}
                        <button type="button" class="show-all-columns js-show-all-columns">Show all</button>
                    </div>
                </details>
            </div>
            <div class="comparison-table-shell">
            <table class="comparison-table" id="{{ table_id }}">
                <thead>
                    <tr>
                        {% for header in section.table.info_headers %}
                        <th>{{ header }}</th>
                        {% endfor %}
                        {% for header in section.table.data_headers %}
                        <th>
                            <span class="run-label">{{ header.name }}</span>
                            <span class="metric-label">{{ header.metric }}</span>
                            {% if header.differences_yaml %}
                            <pre class="run-differences">{{ header.differences_yaml }}</pre>
                            {% endif %}
                        </th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for row in section.table.rows %}
                    <tr>
                        {% for value in row.info_cells %}
                        <td>{{ value }}</td>
                        {% endfor %}
                        {% for value in row.data_cells %}
                        <td>{{ value }}</td>
                        {% endfor %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            </div>
        </div>
        {% endif %}
    </section>
    {% endfor %}
</div>
{% else %}
<p class="empty-report">No comparison data found.</p>
{% endif %}
{% endblock %}
