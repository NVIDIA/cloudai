{% extends "base-report.jinja2" %}

{% block extra_head %}
<meta charset="UTF-8">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/hammerjs@2.0.8/hammer.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.2.0/dist/chartjs-plugin-zoom.min.js"></script>
<style>
    * {
        box-sizing: border-box;
    }
    body {
        max-width: none;
        overflow-x: hidden;
    }
    .comparison-grid {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 1.25rem;
    }
    .comparison-card {
        flex: 0 1 auto;
        width: fit-content;
        min-width: min(100%, 42rem);
        max-width: 100%;
        padding: 1.25rem;
        border: 1px solid var(--nv-border);
        border-radius: var(--radius-lg);
        background: rgba(255, 255, 255, 0.98);
        box-shadow: var(--nv-shadow);
    }
    .comparison-card h2 {
        margin: 0;
        font-size: 1.35rem;
    }
    .comparison-group {
        margin: 0.15rem 0 1rem;
        color: var(--nv-muted);
        font-size: 0.92rem;
    }
    .chart-shell {
        position: relative;
        height: 340px;
        min-height: 260px;
    }
    .chart-shell canvas {
        width: 100% !important;
        height: 100% !important;
    }
    .chart-controls {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem 1rem;
        margin-top: 0.55rem;
    }
    .chart-controls p {
        margin: 0;
        font-size: 0.8rem;
    }
    .reset-zoom {
        padding: 0.35rem 0.7rem;
        border: 1px solid rgba(118, 185, 0, 0.42);
        border-radius: 999px;
        background: var(--nv-surface);
        color: var(--nv-green-strong);
        font-weight: 700;
        cursor: pointer;
    }
    .reset-zoom:hover {
        background: var(--nv-green-soft);
    }
    .case-context {
        margin-top: 0.85rem;
        padding: 0.75rem 0.85rem;
        border: 1px solid rgba(17, 17, 17, 0.07);
        border-radius: var(--radius-md);
        background: var(--nv-surface-alt);
    }
    .case-context summary {
        color: var(--nv-ink);
        font-weight: 700;
        cursor: pointer;
    }
    .case-context-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 30rem), 1fr));
        gap: 0.75rem;
        margin-top: 0.75rem;
    }
    .case-context-card {
        min-width: 0;
        padding: 0.7rem 0.8rem;
        border: 1px solid rgba(17, 17, 17, 0.08);
        border-radius: var(--radius-sm);
        background: var(--nv-surface);
    }
    .case-context-card h3 {
        margin: 0 0 0.45rem;
        font-size: 0.92rem;
    }
    .case-diff-list {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0;
        margin: 0;
        font-family: "SFMono-Regular", SFMono-Regular, Consolas, "Liberation Mono", Menlo, monospace;
        font-size: 0.76rem;
    }
    .case-diff-list dt {
        min-width: 0;
        margin-top: 0.55rem;
        padding-top: 0.55rem;
        border-top: 1px solid rgba(17, 17, 17, 0.06);
        overflow-wrap: anywhere;
        color: var(--nv-muted);
        font-weight: 650;
    }
    .case-diff-list dt:first-of-type {
        margin-top: 0;
        padding-top: 0;
        border-top: 0;
    }
    .case-diff-list dd {
        min-width: 0;
        margin: 0.15rem 0 0;
        overflow-wrap: anywhere;
        word-break: normal;
        color: var(--nv-ink);
    }
    .no-differences {
        margin: 0;
        font-size: 0.8rem;
    }
    .chart-fallback {
        margin: 0.7rem 0 0;
        font-size: 0.88rem;
    }
    .chart-shell.is-enhanced ~ .chart-fallback {
        display: none;
    }
    .comparison-table-shell {
        width: fit-content;
        max-width: 100%;
        overflow-x: auto;
        overscroll-behavior-inline: contain;
        scrollbar-gutter: stable;
        margin-top: 1.1rem;
        border: 1px solid rgba(17, 17, 17, 0.07);
        border-radius: var(--radius-md);
    }
    .comparison-table {
        margin: 0;
        width: max-content;
        max-width: none;
        table-layout: auto;
        border-radius: 0;
        box-shadow: none;
        font-size: 0.9rem;
    }
    .comparison-table td {
        white-space: nowrap;
    }
    .comparison-table th {
        min-width: 8rem;
        vertical-align: bottom;
        white-space: normal;
    }
    .run-label {
        display: block;
        max-width: 18rem;
        overflow-wrap: anywhere;
        color: var(--nv-ink);
    }
    .run-differences {
        margin: 0.45rem 0 0;
        max-width: 18rem;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        word-break: normal;
        color: var(--nv-muted);
        font-size: 0.68rem;
        font-weight: 500;
        line-height: 1.35;
    }
    .metric-label {
        display: block;
        margin-top: 0.2rem;
        color: var(--nv-muted);
        font-size: 0.76rem;
        font-weight: 600;
    }
    .empty-report {
        padding: 1rem;
        border: 1px solid var(--nv-border);
        border-radius: var(--radius-md);
        background: var(--nv-surface);
    }
    @media (max-width: 640px) {
        .comparison-card {
            padding: 1rem;
        }
        .chart-shell {
            height: 300px;
        }
        .comparison-table th,
        .comparison-table td {
            padding: 10px 12px;
        }
        .run-differences {
            max-width: 15rem;
        }
    }
</style>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const rootStyles = getComputedStyle(document.documentElement);
        const nvidiaGreen = rootStyles.getPropertyValue("--nv-green").trim() || "#76b900";
        const nvidiaDarkGray = rootStyles.getPropertyValue("--nv-dark-gray").trim() || "#1e1e1e";
        const pointStyles = ["circle", "rectRot", "triangle", "rect", "star", "crossRot", "dash"];

        function seriesColor(index) {
            if (index === 0) {
                return nvidiaGreen;
            }
            if (index === 1) {
                return nvidiaDarkGray;
            }
            const hue = Math.round((96 + (index - 2) * 137.508) % 360);
            return `hsl(${hue} 68% 40%)`;
        }

        document.querySelectorAll(".js-comparison-chart").forEach((canvas) => {
            const dataNode = document.getElementById(canvas.dataset.chartDataId);
            if (!dataNode || typeof Chart === "undefined") {
                return;
            }

            const payload = JSON.parse(dataNode.textContent);
            const isLine = payload.type === "line";
            const isCategory = payload.x_axis_type === "category";
            const isIndexedCategory = payload.x_axis_type === "indexed_category";

            if (isIndexedCategory) {
                payload.datasets.forEach((dataset) => {
                    dataset.data = dataset.data.map((value, index) => ({x: index, y: value}));
                });
            }
            payload.datasets.forEach((dataset, index) => {
                const color = seriesColor(index);
                dataset.borderColor = color;
                dataset.backgroundColor = color;
                dataset.borderWidth = isLine ? Math.max(2, 5 - index * 0.75) : 1;
                dataset.borderDash = [];
                dataset.borderCapStyle = "round";
                dataset.borderJoinStyle = "round";
                dataset.pointStyle = pointStyles[index % pointStyles.length];
                dataset.pointRadius = isLine ? Math.max(3, 6 - index * 0.5) : 0;
                dataset.pointHoverRadius = isLine ? Math.max(5, 8 - index * 0.5) : 0;
                dataset.pointBorderColor = "#ffffff";
                dataset.pointBorderWidth = isLine ? 1.5 : 0;
                dataset.tension = isLine ? 0.12 : 0;
            });

            const xScale = {
                type: isIndexedCategory ? "linear" : payload.x_axis_type,
                title: {
                    display: true,
                    text: payload.x_axis_label
                },
                grid: {
                    color: "rgba(57, 66, 78, 0.08)"
                }
            };
            if (isIndexedCategory) {
                xScale.min = -0.5;
                xScale.max = payload.labels.length - 0.5;
                xScale.ticks = {
                    stepSize: 1,
                    callback: function (value) {
                        const index = Math.round(value);
                        return Math.abs(value - index) < 0.001 ? (payload.labels[index] || "") : "";
                    }
                };
            }

            const numericValues = payload.datasets.flatMap((dataset) => dataset.data.map((point) => {
                const value = point !== null && typeof point === "object" ? point.y : point;
                return typeof value === "number" && Number.isFinite(value) ? value : null;
            })).filter((value) => value !== null);
            const positiveValues = numericValues.filter((value) => value > 0);
            const useAutoLogScale = payload.y_axis_type === "auto"
                && positiveValues.length === numericValues.length
                && Math.max(...positiveValues) / Math.min(...positiveValues) >= 100;
            const yAxisType = useAutoLogScale ? "logarithmic" :
                (payload.y_axis_type === "auto" ? "linear" : payload.y_axis_type);

            const chart = new Chart(canvas, {
                type: payload.type,
                data: {
                    labels: payload.labels,
                    datasets: payload.datasets
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    devicePixelRatio: Math.min(window.devicePixelRatio || 1, 2),
                    interaction: {
                        mode: "index",
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            position: "bottom",
                            labels: {
                                usePointStyle: true,
                                boxWidth: 10,
                                padding: 16
                            }
                        },
                        tooltip: {
                            callbacks: {
                                title: function (items) {
                                    if (!items.length) {
                                        return "";
                                    }
                                    const parsed = items[0].parsed;
                                    const categoryLabel = isIndexedCategory
                                        ? payload.labels[Math.round(parsed.x)]
                                        : items[0].label;
                                    return payload.x_axis_label + ": "
                                        + ((isCategory || isIndexedCategory) ? categoryLabel : parsed.x);
                                },
                                label: function (context) {
                                    const value = context.parsed.y;
                                    return context.dataset.label + " — " + payload.y_axis_label + ": " + value;
                                }
                            }
                        },
                        zoom: {
                            pan: {
                                enabled: true,
                                mode: "xy",
                                modifierKey: "shift",
                                threshold: 2
                            },
                            zoom: {
                                wheel: {
                                    enabled: false
                                },
                                pinch: {
                                    enabled: true
                                },
                                mode: "xy"
                            }
                        }
                    },
                    scales: {
                        x: xScale,
                        y: {
                            type: yAxisType,
                            beginAtZero: payload.type === "bar" && yAxisType === "linear",
                            title: {
                                display: true,
                                text: payload.y_axis_label + (yAxisType === "logarithmic" ? " (log scale)" : "")
                            },
                            grid: {
                                color: "rgba(57, 66, 78, 0.10)"
                            }
                        }
                    }
                }
            });
            canvas.parentElement.classList.add("is-enhanced");

            canvas.addEventListener("wheel", function (event) {
                const isShiftWheel = event.shiftKey;
                const isTrackpadPinch = event.ctrlKey && !event.shiftKey;
                if (!isShiftWheel && !isTrackpadPinch) {
                    return;
                }

                const delta = Math.abs(event.deltaY) >= Math.abs(event.deltaX) ? event.deltaY : event.deltaX;
                if (delta === 0) {
                    return;
                }

                event.preventDefault();
                const speed = 0.1;
                const factor = delta < 0 ? 1 + speed : 2 - 1 / (1 - speed);
                const rect = canvas.getBoundingClientRect();
                chart.zoom(
                    {
                        x: factor,
                        y: factor,
                        focalPoint: {
                            x: event.clientX - rect.left,
                            y: event.clientY - rect.top
                        }
                    },
                    "none"
                );
            }, {passive: false});

            const card = canvas.closest(".comparison-card");
            const fallback = card ? card.querySelector(".chart-fallback") : null;
            if (fallback) {
                fallback.hidden = true;
            }
            const resetButton = card ? card.querySelector(".js-reset-zoom") : null;
            if (resetButton && typeof chart.resetZoom === "function") {
                resetButton.addEventListener("click", function () {
                    chart.resetZoom();
                });
                canvas.addEventListener("dblclick", function () {
                    chart.resetZoom();
                });
            } else if (resetButton) {
                resetButton.hidden = true;
            }
        });
    });
</script>
{% endblock %}

{% block content %}
{% if sections %}
<div class="comparison-grid">
    {% for section in sections %}
    <section class="comparison-card">
        <h2>{{ section.title }}</h2>
        <p class="comparison-group">{{ section.group_name }}</p>

        <div class="chart-shell">
            <canvas
                class="js-comparison-chart"
                data-chart-data-id="{{ section.chart.id }}-data"
                aria-label="{{ section.title }} comparison chart"
            ></canvas>
        </div>
        <div class="chart-controls">
            <p>Shift + wheel or pinch to zoom · Shift + drag to pan · double-click to reset</p>
            <button type="button" class="reset-zoom js-reset-zoom">Reset view</button>
        </div>
        <p class="chart-fallback">Interactive chart unavailable. The complete numeric data remains available below.</p>
        <noscript><p class="chart-fallback">JavaScript is disabled. The complete numeric data remains available below.</p></noscript>
        <script type="application/json" id="{{ section.chart.id }}-data">{{ section.chart | tojson }}</script>

        <details class="case-context">
            <summary>Compared case parameters</summary>
            <div class="case-context-grid">
                {% for case in section.case_details %}
                <article class="case-context-card">
                    <h3>{{ case.name }}</h3>
                    {% if case.differences %}
                    <dl class="case-diff-list">
                        {% for difference in case.differences %}
                        <dt>{{ difference.name }}</dt>
                        <dd>{{ difference.value }}</dd>
                        {% endfor %}
                    </dl>
                    {% else %}
                    <p class="no-differences">No differing parameters.</p>
                    {% endif %}
                </article>
                {% endfor %}
            </div>
        </details>

        <div class="comparison-table-shell">
            <table class="comparison-table">
                <thead>
                    <tr>
                        {% for header in section.table.info_headers %}
                        <th>{{ header }}</th>
                        {% endfor %}
                        {% for header in section.table.data_headers %}
                        <th>
                            <span class="run-label">{{ header.name }}</span>
                            <span class="metric-label">{{ header.metric }}</span>
                            {% if header.differences_yaml %}
                            <pre class="run-differences">{{ header.differences_yaml }}</pre>
                            {% endif %}
                        </th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for row in section.table.rows %}
                    <tr>
                        {% for value in row.info_cells %}
                        <td>{{ value }}</td>
                        {% endfor %}
                        {% for value in row.data_cells %}
                        <td>{{ value }}</td>
                        {% endfor %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
    {% endfor %}
</div>
{% else %}
<p class="empty-report">No comparison data found.</p>
{% endif %}
{% endblock %}
